<module name="">
    <!-- 道具表 -->
    <table name="TbItem" value="item.Item" index="Id" input="tb_item.xlsx"/>
    <!-- 宝箱档位表 -->
    <table name="TbChest" value="chest.Chest" index="Id" input="tb_chest.xlsx"/>
    <!-- 宝箱金额生成器（GenMode=1 时生效） -->
    <table name="TbChestGen" value="chest.ChestGen" index="ChestId" input="tb_chestgen.xlsx"/>
    <!-- 收购系数表（Id=已排除次数） -->
    <table name="TbBankerFactor" value="chest.BankerFactor" index="Id" input="tb_banker.xlsx"/>
    <!-- 角色表 -->
    <table name="TbCharacter" value="character.Character" index="Id" input="tb_character.xlsx"/>
    <!-- 抢宝房配置 -->
    <table name="TbRushRoom" value="rush.RushRoom" index="Id" input="tb_rushroom.xlsx"/>
    <!-- 玩家等级表 -->
    <table name="TbLevel" value="level.Level" index="Id" input="tb_level.xlsx"/>
    <!-- 多语言文本表（Key = 中文原文） -->
    <table name="TbText" value="l10n.TextItem" index="Key" input="tb_text.xlsx"/>
    <!-- 玩法开关表 -->
    <table name="TbFeature" value="feature.Feature" index="Id" input="tb_feature.xlsx"/>
    <!-- 广告位配置 -->
    <table name="TbAd" value="ad.Ad" index="Id" input="tb_ad.xlsx"/>
        <!-- 每日任务池 -->
    <table name="TbQuest" value="quest.Quest" index="Id" input="tb_quest.xlsx"/>
        <!-- 全局配置（单例表） -->
    <table name="TbGlobal" value="global.Global" mode="one" input="tb_global.xlsx"/>
</module>
