<module name="">
    <module name="item">
        <!-- 道具（通用，未来宝箱奖励等场景使用） -->
        <bean name="Item">
            <var name="Id" type="int"/>
            <var name="Name" type="string"/>
            <var name="Desc" type="string"/>
            <var name="Quality" type="EItemQuality"/>
            <var name="Price" type="int"/>
            <var name="MaxStack" type="int"/>
        </bean>
    </module>

    <module name="chest">
        <!-- 宝箱档位：固定 20 格金额池，购买时随机洗牌位置 -->
        <bean name="Chest">
            <var name="Id" type="int"/>
            <var name="Name" type="string"/>
            <var name="Price" type="int"/>
            <var name="SlotAmounts" type="list#sep=|,int"/>
            <var name="ColorHex" type="string"/>
            <!-- 0=固定金额池（洗牌） 1=算法生成（稀有度模板+EV归一化，见 TbChestGen） -->
            <var name="GenMode" type="int"/>
            <!-- 0=普通 1=双头奖（金额池直接配置两个头奖） 2=幸运格 3=陷阱格 -->
            <var name="Kind" type="int"/>
            <!-- 特殊格数量（Kind 2/3 生效） -->
            <var name="SpecialCount" type="int"/>
            <!-- 每个特殊格的奖/罚金额 -->
            <var name="SpecialValue" type="int"/>
        </bean>
        <!-- 宝箱金额生成器：权重 Roll 稀有度档 → 档位基准 × 对数正态扰动 → 归一化到固定池期望 -->
        <bean name="ChestGen">
            <var name="ChestId" type="int"/>
            <!-- 5 档稀有度权重（白/绿/蓝/紫/金，不必归一） -->
            <var name="Weights" type="list#sep=|,float"/>
            <!-- 5 档基准金额（应使加权均值 ≈ 固定池期望，减少归一化形变） -->
            <var name="Bases" type="list#sep=|,int"/>
            <!-- 对数正态扰动强度（0~0.5，档内金额波动） -->
            <var name="Jitter" type="float"/>
        </bean>
        <!-- 收购系数：按已排除次数查表（收购价 = 剩余期望 × 系数） -->
        <bean name="BankerFactor">
            <var name="Id" type="int"/>
            <var name="Factor" type="float"/>
        </bean>
    </module>

    <module name="character">
        <!-- 角色：决定携带的技能 -->
        <bean name="Character">
            <var name="Id" type="int"/>
            <var name="Name" type="string"/>
            <!-- 技能类型：1=洞察 2=抬价 3=免费排除（热更代码内 switch） -->
            <var name="SkillType" type="int"/>
            <var name="SkillName" type="string"/>
            <var name="SkillDesc" type="string"/>
            <var name="ColorHex" type="string"/>
            <!-- 技能冷却（秒）：使用后该技能进入冷却，跨宝箱生效，防止反复刷强力技能；0=无冷却 -->
            <var name="SkillCooldownSec" type="int"/>
        </bean>
    </module>

    <module name="rush">
        <!-- 抢宝房：实时多人抢格（红包玩法） -->
        <bean name="RushRoom">
            <var name="Id" type="int"/>
            <var name="Name" type="string"/>
            <!-- 门票（金币） -->
            <var name="Ticket" type="int"/>
            <!-- 房间人数（含机器人补位） -->
            <var name="PlayerCount" type="int"/>
            <!-- 抢宝时长（秒） -->
            <var name="DurationSec" type="int"/>
            <!-- 开抢倒计时（秒） -->
            <var name="CountdownSec" type="int"/>
            <!-- 奖池 = 门票 × 人数 × 倍率 -->
            <var name="PoolScale" type="float"/>
            <var name="ColorHex" type="string"/>
            <!-- 盲抢：开抢时金额不可见，抢到才揭示（机器人同样不可见，公平博弈） -->
            <var name="Blind" type="bool"/>
        </bean>
    </module>

    <module name="level">
        <!-- 玩家等级：经验门槛与解锁说明（累计经验达到 XpNeed 升到该级） -->
        <bean name="Level">
            <var name="Id" type="int"/>
            <var name="XpNeed" type="int"/>
            <var name="UnlockText" type="string"/>
        </bean>
    </module>

    <module name="l10n">
        <!-- 多语言文本：Key = 中文原文；值按语言列 -->
        <bean name="TextItem">
            <var name="Key" type="string"/>
            <var name="En" type="string"/>
        </bean>
    </module>

    <module name="global">
        <!-- 全局配置（单例） -->
        <bean name="Global">
            <var name="ChestInitGold" type="int"/>
            <var name="ChestFreeEliminates" type="int"/>
            <var name="ChestEliminateBaseFee" type="int"/>
            <var name="ChestEliminateFeeGrowth" type="int"/>
            <var name="AuctionFeeRate" type="float"/>
            <!-- 每个宝箱可使用的技能次数上限 -->
            <var name="ChestMaxSkillUses" type="int"/>
            <!-- 拍卖时长（秒）与最小加价比例 -->
            <var name="AuctionDurationSec" type="int"/>
            <var name="AuctionBidStepPct" type="float"/>
            <!-- 每日挑战：门票 / 每日次数 / 使用的宝箱档位 -->
            <var name="DailyTicketCost" type="int"/>
            <var name="DailyAttemptsPerDay" type="int"/>
            <var name="DailyChestId" type="int"/>
            <!-- 抢宝房：机器人补位前等待秒 / 机器人抢格最小最大间隔毫秒 -->
            <var name="RushBotFillDelaySec" type="int"/>
            <var name="RushBotClaimMinMs" type="int"/>
            <var name="RushBotClaimMaxMs" type="int"/>
            <!-- 银行家报价：每排除 N 格触发 / 有效期秒 / 浮动幅度 -->
            <var name="OfferEveryNElims" type="int"/>
            <var name="OfferValidSec" type="int"/>
            <var name="OfferJitter" type="float"/>
            <!-- 镜像对决：入场金 / 使用宝箱档位 / 单局时限秒（抽成沿用 AuctionFeeRate，补位等待沿用 RushBotFillDelaySec） -->
            <var name="DuelStake" type="int"/>
            <var name="DuelChestId" type="int"/>
            <var name="DuelMatchSec" type="int"/>
        </bean>
    </module>

    <module name="ad">
        <!-- 广告位（激励视频）：服务端权威发奖（日限/冷却/防刷）；RewardGold 与 RewardChestId 均为 0 = 清除全部技能冷却 -->
        <bean name="Ad">
            <var name="Id" type="string"/>
            <var name="Name" type="string"/>
            <var name="Desc" type="string"/>
            <!-- 每日次数上限 -->
            <var name="DailyLimit" type="int"/>
            <!-- 两次使用最小间隔（秒） -->
            <var name="CooldownSec" type="int"/>
            <!-- 奖励金币（0=无） -->
            <var name="RewardGold" type="int"/>
            <!-- 奖励宝箱档位（0=无） -->
            <var name="RewardChestId" type="int"/>
        </bean>
    </module>

    <module name="feature">
        <!-- 玩法开关：服务端拦截对应路由/WS，客户端隐藏入口；缺行 = 默认开启 -->
        <bean name="Feature">
            <var name="Id" type="string"/>
            <var name="Enabled" type="bool"/>
            <var name="Desc" type="string"/>
        </bean>
    </module>
</module>
