<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
    <RootNamespace>SimpleGameServer</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Core" Version="1.1.0" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="*" />
  </ItemGroup>

  <!-- Luban 运行时（纯 C# 部分，SimpleJSONUnity.cs 有 UNITY 宏保护可包含亦可跳过） -->
  <ItemGroup>
    <Compile Include="../Packages/com.code-philosophy.luban/Runtime/BeanBase.cs" />
    <Compile Include="../Packages/com.code-philosophy.luban/Runtime/ByteBuf.cs" />
    <Compile Include="../Packages/com.code-philosophy.luban/Runtime/StringUtil.cs" />
    <Compile Include="../Packages/com.code-philosophy.luban/Runtime/SimpleJSON/SimpleJSON.cs" />
    <Compile Include="../Packages/com.code-philosophy.luban/Runtime/SimpleJSON/SimpleJSONBinary.cs" />
    <Compile Include="../Packages/com.code-philosophy.luban/Runtime/SimpleJSON/SimpleJSONDotNetTypes.cs" />
  </ItemGroup>

  <!-- Luban 生成的服务端配置代码（gen_server.bat 产物，SDK 自动包含 LubanGen/） -->

</Project>
